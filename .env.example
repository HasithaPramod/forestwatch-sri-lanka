NODE_ENV=development

# API
API_PORT=3001
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:3000

# Database — native PostgreSQL + PostGIS on localhost:5432 (no Docker).
# Create it with:  $env:PGPASSWORD='<superuser password>'; .\scripts\setup-local-db.ps1
# Or paste a Neon/Supabase PostGIS URI (required on Vercel Hobby — Vercel does not host Postgres).
DATABASE_URL=postgresql://forestwatch:forestwatch@localhost:5432/forestwatch

# Development seed only. Never use these accounts in production.
DEV_SEED_PASSWORD=ForestWatch!dev

# Auth secrets — replace before deploying. Never commit real values.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Storage: local | supabase
# Vercel has no persistent disk — production must use supabase with real dashboard credentials.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/api/v1/files

# Optional. Leave empty for local development. Never invent credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Public API origin only — no service-role keys
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Optional Expo override. Leave unset so a device uses the Metro LAN host (Android emulator: 10.0.2.2).
# EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
