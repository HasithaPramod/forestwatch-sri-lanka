{
  "name": "forestwatch-sri-lanka",
  "private": true,
  "version": "0.0.1",
  "description": "National tree planting, geo-monitoring, community verification, and ForestQuest platform for Sri Lanka.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @forestwatch/database prisma:generate",
    "db:migrate": "pnpm --filter @forestwatch/database migrate",
    "db:seed": "pnpm --filter @forestwatch/database seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
